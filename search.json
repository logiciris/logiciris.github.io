permalink: /search.json
sitemap: false
---
[{% assign all = site.posts | concat: site.notes | sort: "date" | reverse %}{% for d in all %}{"title":{{ d.title | jsonify }},"url":{{ d.url | relative_url | jsonify }},"kind":"{% if d.collection == 'notes' %}Notes{% else %}Posts{% endif %}","tags":{{ d.tags | jsonify }},"category":{{ d.categories | join: ' / ' | jsonify }},"desc":{{ d.description | default: "" | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
